    [SysEntryPointAttribute(true)]
    public TMK_CustomerCreationResponseContract ChangeAccountStatus(TMK_CustomerStatusChangeContract _contract)
    {
        TMK_CustomerCreationResponseContract response = new TMK_CustomerCreationResponseContract();
        CustTable custTable;

        if (!_contract.parmCustomerAccountNumber())
        {
            response = this.fail(
                '',
                'CustomerAccountNumber',
                '',
                "Customer account number is required.");

            TMK_IntegrationLogTable::logMessage('Change Customer Account Status', _contract, response, response.parmMessage(), false);
            return response;
        }

        if (!_contract.parmAccountStatus())
        {
            response = this.fail(
                _contract.parmCustomerAccountNumber(),
                'AccountStatus',
                '',
                "Account status is required.");

            TMK_IntegrationLogTable::logMessage('Change Customer Account Status', _contract, response, response.parmMessage(), false);
            return response;
        }

        if (!this.accountStatusExists(_contract.parmAccountStatus()))
        {
            response = this.fail(
                _contract.parmCustomerAccountNumber(),
                'AccountStatus',
                _contract.parmAccountStatus(),
                strFmt("Account status %1 does not exist.", _contract.parmAccountStatus()));

            TMK_IntegrationLogTable::logMessage('Change Customer Account Status', _contract, response, response.parmMessage(), false);
            return response;
        }

        ttsbegin;

        try
        {
            select firstonly forupdate custTable
                where custTable.AccountNum == _contract.parmCustomerAccountNumber();

            if (!custTable.RecId)
            {
                ttsabort;

                response = this.fail(
                    _contract.parmCustomerAccountNumber(),
                    'CustomerAccountNumber',
                    _contract.parmCustomerAccountNumber(),
                    strFmt("Customer %1 does not exist.", _contract.parmCustomerAccountNumber()));

                TMK_IntegrationLogTable::logMessage('Change Customer Account Status', _contract, response, response.parmMessage(), false);
                return response;
            }

            custTable.CredManAccountStatusId = _contract.parmAccountStatus();
            custTable.update();

            ttscommit;
            if(CustTableChangeProposalFieldEnablement::findOrCreate(CustTableChangeProposalField::CredManAccountStatusId).IsEnabled == NoYes::Yes)
            {
                response.parmCustomerAccountNumber(custTable.AccountNum);
                response.parmStatus(true);
                response.parmRejectedField('');
                response.parmRejectedValue('');
                response.parmMessage(strFmt("Customer %1 account status updated and waiting the proposal approval.", custTable.AccountNum));
            }

            
            response.parmCustomerAccountNumber(custTable.AccountNum);
            response.parmStatus(true);
            response.parmRejectedField('');
            response.parmRejectedValue('');
            response.parmMessage(strFmt("Customer %1 account status updated successfully.", custTable.AccountNum));

            TMK_IntegrationLogTable::logMessage('Change Customer Account Status', _contract, response, response.parmMessage(), true);
            return response;
        }
        catch (Exception::Error)
        {
            ttsabort;

            response.parmCustomerAccountNumber(_contract.parmCustomerAccountNumber());
            response.parmStatus(false);
            response.parmRejectedField('System');
            response.parmRejectedValue(_contract.parmCustomerAccountNumber());
            response.parmMessage(TMK_LogistchainCustomerService::getErrorMesg());

            TMK_IntegrationLogTable::logMessage('Change Customer Account Status', _contract, response, response.parmMessage(), false);
            return response;
        }
    }

    private TMK_CustomerCreationResponseContract validateCreateCustomerContract(TMK_CustomerCreationContract _contract)
    {
        TMK_CustomerCreationResponseContract response = new TMK_CustomerCreationResponseContract();

        response.parmStatus(true);

        if (!_contract.parmCustomerAccountNumber())
        {
            return this.fail('', 'CustomerAccountNumber', '', "Customer account number is required.");
        }

        if (!_contract.parmType())
        {
            return this.fail(_contract.parmCustomerAccountNumber(), 'Type', '', "Customer type is required.");
        }

        if (_contract.parmType() != 'Person' && _contract.parmType() != 'Organization')
        {
            return this.fail(
                _contract.parmCustomerAccountNumber(),
                'Type',
                _contract.parmType(),
                "Customer type must be Person or Organization.");
        }

        // Same validation criteria for Person and Organization:
        // English First and Last are required.
        // English Middle is optional.
        // Arabic First and Last are required.
        // Arabic Middle is optional.
        if (!_contract.parmFirstName())
        {
            return this.fail(
                _contract.parmCustomerAccountNumber(),
                'FirstName',
                '',
                strFmt("First name is required for %1 customer.", _contract.parmType()));
        }

        if(_contract.parmType() == "Person")
        {
            if (!_contract.parmLastName())
            {
                return this.fail(
                    _contract.parmCustomerAccountNumber(),
                    'LastName',
                    '',
                    strFmt("Last name is required for %1 customer.", _contract.parmType()));
            }
        }
        if (!_contract.parmArabicFirstName())
        {
            return this.fail(
                _contract.parmCustomerAccountNumber(),
                'ArabicFirstName',
                '',
                strFmt("Arabic first name is required for %1 customer.", _contract.parmType()));
        }
        if(_contract.parmType() == "Person")
        {
            if (!_contract.parmArabicLastName())
            {
                return this.fail(
                    _contract.parmCustomerAccountNumber(),
                    'ArabicLastName',
                    '',
                    strFmt("Arabic last name is required for %1 customer.", _contract.parmType()));
            }
        }
        if (!_contract.parmTermsOfPayment())
        {
            return this.fail(_contract.parmCustomerAccountNumber(), 'TermsOfPayment', '', "Terms of payment is required.");
        }

        return response;
    }

    private TMK_CustomerCreationResponseContract fail(
        AccountNum _customerAccountNumber,
        str        _field,
        str        _value,
        str        _reason)
    {
        TMK_CustomerCreationResponseContract response = new TMK_CustomerCreationResponseContract();

        response.parmCustomerAccountNumber(_customerAccountNumber);
        response.parmStatus(false);
        response.parmRejectedField(_field);
        response.parmRejectedValue(_value);
        response.parmMessage(strFmt("RejectedField: %1 | RejectedValue: %2 | Reason: %3", _field, _value, _reason));

        return response;
    }

    private Name buildEnglishName(TMK_CustomerCreationContract _contract)
    {
        Name nameValue;

        // Enhancement:
        // Person and Organization both use First + Middle + Last.
        nameValue = strLRTrim(strFmt(
            "%1 %2 %3",
            _contract.parmFirstName(),
            _contract.parmMiddleName(),
            _contract.parmLastName()));

        return nameValue;
    }

    private Name buildArabicName(TMK_CustomerCreationContract _contract)
    {
        Name nameValue;

        // Enhancement:
        // Person and Organization both use Arabic First + Arabic Middle + Arabic Last.
        nameValue = strLRTrim(strFmt(
            "%1 %2 %3",
            _contract.parmArabicFirstName(),
            _contract.parmArabicMiddleName(),
            _contract.parmArabicLastName()));

        return nameValue;
    }

    private DirPartyType getPartyType(str _type)
    {
        if (_type == 'Person')
        {
            return DirPartyType::Person;
        }

        return DirPartyType::Organization;
    }

    private boolean accountStatusExists(str _accountStatus)
    {
        CredManAccountStatusTable accountStatus;

        select firstonly RecId from accountStatus
            where accountStatus.CustAccountStatusId == _accountStatus;

        return accountStatus.RecId != 0;
    }

    private void createPostalAddress(
        DirPartyRecId          _partyRecId,
        AccountNum             _accountNum,
        Description            _addressName,
        addressCountryRegionId _countryRegionId,
        addressZipCodeId       _postalCode,
        StreetName             _street,
        addressCity            _city,
        addressStateId         _state)
    {

        DirPartyPostalAddressView addressView;
        DirParty                  dirParty;

        dirParty = DirParty::constructFromPartyRecId(_partyRecId);

        addressView.clear();
        addressView.Party           = _partyRecId;
        addressView.LocationName    = _addressName;
        addressView.Address         = _addressName;
        addressView.CountryRegionId = _countryRegionId;
        addressView.ZipCode         = _postalCode;
        addressView.Street          = _street;
        addressView.City            = _city;
        addressView.State           = _state;
        addressView.IsPrimary       = NoYes::Yes;

        dirParty.createOrUpdatePostalAddress(addressView);
    }

    private void createOrUpdateContactInfo(
        DirPartyRecId _partyRecId,
        str           _locator,
        LogisticsElectronicAddressMethodType _type,
        Description   _locationName)
    {
        DirPartyContactInfoView contactInfoView;
        DirParty                dirParty;

        if (!_locator)
        {
            return;
        }

        dirParty = DirParty::constructFromPartyRecId(_partyRecId);

        contactInfoView.clear();
        contactInfoView.LocationName = _locationName;
        contactInfoView.Locator      = _locator;
        contactInfoView.Type         = _type;
        contactInfoView.IsPrimary    = NoYes::Yes;

        dirParty.createOrUpdateContactInfo(contactInfoView);
    }

    public static str getErrorMesg()
    {
        Log                  errorMessage;
        SysInfologEnumerator sysInfologEnumerator;

        sysInfologEnumerator = SysInfologEnumerator::newData(infolog.infologData());
        errorMessage = "";

        while (sysInfologEnumerator.moveNext())
        {
            errorMessage += sysInfologEnumerator.currentMessage() + " ; ";
        }

        return errorMessage;
    }

